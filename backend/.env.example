# GGUF Editor backend configuration.
#
# Copy to `.env` (next to this file) and adjust. Every setting is optional —
# the values below are the built-in defaults. All variables use the
# `GGUF_EDITOR_` prefix and are read by `app/config.py`.

# Directory holding the SQLite database, the Fernet secret key, and backups.
# Defaults to `backend/data`.
#GGUF_EDITOR_DATA_DIR=./data

# Model roots to register automatically on first launch. Comma separated,
# each entry either `label:path` or a bare `path`. Handy for Docker volumes.
#GGUF_EDITOR_DEFAULT_ROOTS=Models:/models,Ollama:/root/.ollama/models

# Origins allowed to call the API (the Next.js dev server by default).
#GGUF_EDITOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Array metadata longer than this is truncated to a preview in `/inspect`
# (token lists and merge tables can hold hundreds of thousands of entries).
#GGUF_EDITOR_MAX_INLINE_ARRAY_ITEMS=32

# Network timeout, in seconds, for outbound LLM provider requests.
#GGUF_EDITOR_LLM_REQUEST_TIMEOUT=120
